{
  "name": "@arx-ai/arx-subprocess-local",
  "description": "Local-subprocess implementation of the arx Harness subprocess seam",
  "version": "1.0.43",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "koffi": "^3.1.0 <3.3.2 || ^3.3.4",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-loader-smoke": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
