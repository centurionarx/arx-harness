{
  "name": "@arx-ai/arx-spill-policy",
  "description": "Tool-result spill policy for the arx Harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "1.0.38",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-output-retention": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-spill": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-code-runtime-worker-thread": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-output-retention": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-spill": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
