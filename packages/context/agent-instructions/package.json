{
  "name": "@arx-ai/arx-agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "1.0.25",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-fs": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-home-paths": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-loop": "workspace:^",
    "@arx-ai/arx-fs": "workspace:^",
    "@arx-ai/arx-fs-local": "workspace:^",
    "@arx-ai/arx-home-paths": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-llm-pi-ai": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-system-prompt": "workspace:^",
    "@arx-ai/arx-tool-fs": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^"
  }
}
