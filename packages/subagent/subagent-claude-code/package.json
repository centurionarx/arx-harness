{
  "name": "@arx-ai/arx-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "1.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "arx": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@arx-ai/arx-claude-agent-sdk-process": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.93.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@arx-ai/schemastery": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-claude-agent-sdk-process": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-loader-smoke": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-subprocess-local": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
