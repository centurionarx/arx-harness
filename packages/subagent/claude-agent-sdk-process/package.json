{
  "name": "@centurionarx/cxh-claude-agent-sdk-process",
  "description": "Harness-owned process tree for the CLI the official Claude Agent SDK spawns: environment overlay, spawn-spec translation, and the SDK-facing process projection",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/subagent/claude-agent-sdk-process"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-subprocess": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220"
  },
  "devDependencies": {
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-subprocess": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  }
}
