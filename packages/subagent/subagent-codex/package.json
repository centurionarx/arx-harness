{
  "name": "@arx-ai/arx-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "1.0.26",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "arx": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/arx-sdk-protocol": "workspace:^",
    "@arx-ai/schemastery": "workspace:^",
    "@openai/codex": "0.147.0"
  },
  "devDependencies": {
    "@arx-ai/cordis-plugin-loader": "workspace:^",
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-loader-smoke": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-subprocess-local": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
