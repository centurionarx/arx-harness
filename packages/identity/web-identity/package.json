{
  "name": "@arx-ai/arx-web-identity",
  "version": "1.0.55",
  "description": "Native web identity web-identity",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/types/contract.js"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-workspace": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-workspace": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/identity/web-identity"
  }
}
