{
  "name": "@arx-ai/arx-llm-retry",
  "description": "Provider-routed LLM request retry policy for the arx Harness",
  "version": "1.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-loop": "workspace:^",
    "@arx-ai/arx-agent-loop-testkit": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-llm-mock-server": "workspace:^",
    "@arx-ai/arx-llm-pi-ai": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence-jsonl": "workspace:^",
    "@arx-ai/arx-session-persistence-sqlite": "workspace:^",
    "@arx-ai/arx-system-prompt": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/cordis-plugin-include": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^"
  }
