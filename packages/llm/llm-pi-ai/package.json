{
  "name": "@arx-ai/arx-llm-pi-ai",
  "description": "pi-ai-backed multi-provider adapter for the arx Harness LLM seam",
  "version": "1.0.43",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-attachment": "workspace:^",
    "@arx-ai/arx-authorization": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-launch-environment": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-attachment": "workspace:^",
    "@arx-ai/arx-authorization": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-launch-environment": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
