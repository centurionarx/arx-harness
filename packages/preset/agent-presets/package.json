{
  "name": "@arx-ai/arx-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the arx Harness",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/cordis-plugin-include": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^",
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-atomic-write": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-home-paths": "workspace:^",
    "@arx-ai/arx-scope": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-system-prompt": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis-plugin-include": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^",
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-loop": "workspace:^",
    "@arx-ai/arx-atomic-write": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-home-paths": "workspace:^",
    "@arx-ai/arx-scope": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-settings-file": "workspace:^",
    "@arx-ai/arx-system-prompt": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
