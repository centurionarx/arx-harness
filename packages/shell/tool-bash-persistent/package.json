{
  "name": "@centurionarx/cxh-tool-bash-persistent",
  "description": "Model-facing owner-scoped persistent Bash tool backed by the Harness PTY service",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/shell/tool-bash-persistent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-terminal": "workspace:^",
    "@centurionarx/cxh-timeout": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  },
  "dependencies": {
    "@centurionarx/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cordis-plugin-include": "workspace:^",
    "@centurionarx/cordis-plugin-loader": "workspace:^",
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-terminal": "workspace:^",
    "@centurionarx/cxh-terminal-bash": "workspace:^",
    "@centurionarx/cxh-sandbox": "workspace:^",
    "@centurionarx/cxh-sandbox-policy": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-subprocess-local": "workspace:^",
    "@centurionarx/cxh-system-prompt": "workspace:^",
    "@centurionarx/cxh-timeout": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  }
}
