{
  "name": "@arx-ai/arx-tool-lsp",
  "description": "Model-facing lsp tool over the arx Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "1.0.33",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-lsp": "workspace:^",
    "@arx-ai/arx-system-prompt": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-fs-local": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-lsp": "workspace:^",
    "@arx-ai/arx-lsp-stdio": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subprocess-local": "workspace:^",
    "@arx-ai/arx-system-prompt": "workspace:^",
    "@arx-ai/arx-timeout": "workspace:^",
    "@arx-ai/arx-tool-call-timeout-policy": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
