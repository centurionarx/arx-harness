{
  "name": "@centurionarx/cxh-tool-lsp",
  "description": "Model-facing lsp tool over the CENTURIONarx Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-lsp": "workspace:^",
    "@centurionarx/cxh-system-prompt": "workspace:^",
    "@centurionarx/cxh-timeout": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  },
  "dependencies": {
    "@centurionarx/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-fs-local": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-lsp": "workspace:^",
    "@centurionarx/cxh-lsp-stdio": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-subprocess-local": "workspace:^",
    "@centurionarx/cxh-system-prompt": "workspace:^",
    "@centurionarx/cxh-timeout": "workspace:^",
    "@centurionarx/cxh-tool-call-timeout-policy": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  }
}
