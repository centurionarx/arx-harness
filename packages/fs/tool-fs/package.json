{
  "name": "@centurionarx/cxh-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the CENTURIONarx Harness filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@centurionarx/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@centurionarx/cxh-attachment": "workspace:^",
    "@centurionarx/cxh-fs": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-sandbox": "workspace:^",
    "@centurionarx/cxh-sandbox-policy": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-system-prompt": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cxh-user-approval": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-agent-loop": "workspace:^",
    "@centurionarx/cxh-agent-loop-testkit": "workspace:^",
    "@centurionarx/cxh-attachment": "workspace:^",
    "@centurionarx/cxh-fs": "workspace:^",
    "@centurionarx/cxh-fs-local": "workspace:^",
    "@centurionarx/cxh-fs-observation-policy": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-llm-deepseek": "workspace:^",
    "@centurionarx/cxh-sandbox": "workspace:^",
    "@centurionarx/cxh-sandbox-policy": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-system-prompt": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cxh-user-approval": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  }
}
