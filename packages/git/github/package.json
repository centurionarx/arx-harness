{
  "name": "@arx-ai/arx-github",
  "description": "Host-only read-only GitHub Remote service and private human PAT authorization",
  "version": "1.0.43",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/git/github"
  },
  "peerDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-authorization": "workspace:^",
    "@arx-ai/arx-typert-protocol": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-authorization": "workspace:^",
    "@arx-ai/arx-typert-protocol": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^",
    "@arx-ai/cordis-plugin-include": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  }
}
