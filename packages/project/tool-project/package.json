{
  "name": "@arx-ai/arx-tool-project",
  "description": "Model-facing durable project, plan, prompt, task, and workflow orchestration tool",
  "version": "1.0.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
