{
  "name": "@arx-ai/arx-project-runner",
  "description": "Resume saved project steps through owned subagents and durable checkpoints",
  "version": "1.0.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/project/project-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-project": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-project": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-storage": "workspace:^",
    "@arx-ai/arx-storage-domain": "workspace:^",
    "@arx-ai/arx-storage-json": "workspace:^",
    "@arx-ai/arx-workspace": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^"
  }
}
