{
  "name": "@centurionarx/cxh-client-ui-goal",
  "description": "Session goal surface: GoalBar docked above the composer, read from the goal session projection",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/client/ui-goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cxh": {
    "client": {
      "inject": [
        "@centurionarx/cxh-client-runtime",
        "@centurionarx/cxh-api-remotes",
        "@centurionarx/cxh-client-locale",
        "@centurionarx/cxh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@centurionarx/cxh-client-locale": "workspace:^",
    "@centurionarx/cxh-api-remotes": "workspace:^",
    "@centurionarx/cxh-client-runtime": "workspace:^",
    "@centurionarx/cxh-client-ui-conversation": "workspace:^",
    "@centurionarx/cxh-commands": "workspace:^",
    "@centurionarx/cxh-goal": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cordis": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cxh-client-locale": "workspace:^",
    "@centurionarx/cxh-api-remotes": "workspace:^",
    "@centurionarx/cxh-client-runtime": "workspace:^",
    "@centurionarx/cxh-client-test-runtime": "workspace:^",
    "@centurionarx/cxh-client-ui-conversation": "workspace:^",
    "@centurionarx/cxh-client-ui-primitives": "workspace:^",
    "@centurionarx/cxh-client-ui-slots": "workspace:^",
    "@centurionarx/cxh-commands": "workspace:^",
    "@centurionarx/cxh-goal": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@centurionarx/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-typert-protocol": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
