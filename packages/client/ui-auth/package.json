{
  "name": "@arx-ai/arx-client-ui-auth",
  "description": "Native web identity: public, administration, and own-account slot compositions",
  "version": "1.0.67",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/client/ui-auth"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./browser": {
      "types": "./lib/types/browser.d.ts",
      "default": "./lib/browser.js"
    }
  },
  "arx": {
    "client": {
      "inject": [
        "@arx-ai/arx-client-slots",
        "@arx-ai/arx-client-locale",
        "@arx-ai/arx-client-ui-theme",
        "@arx-ai/arx-client-ui-renderer"
      ],
      "external": [
        "@arx-ai/arx-client-slots/client"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-client-slots": "workspace:^",
    "@arx-ai/arx-client-locale": "workspace:^",
    "@arx-ai/arx-client-ui-theme": "workspace:^",
    "@arx-ai/arx-web-identity": "workspace:^",
    "@arx-ai/arx-project-storage": "workspace:^",
    "@arx-ai/arx-client-runtime": "workspace:^",
    "@arx-ai/arx-client-ui-renderer": "workspace:^",
    "@arx-ai/arx-client-ui-settings-general": "workspace:^",
    "@arx-ai/arx-client-ui-sidebar": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-client-slots": "workspace:^",
    "@arx-ai/arx-client-ui-slots": "workspace:^",
    "@arx-ai/arx-client-locale": "workspace:^",
    "@arx-ai/arx-client-ui-theme": "workspace:^",
    "@arx-ai/arx-web-identity": "workspace:^",
    "@arx-ai/arx-project-storage": "workspace:^",
    "@arx-ai/arx-client-ui-renderer": "workspace:^",
    "@arx-ai/arx-client-ui-sidebar": "workspace:^",
    "@arx-ai/arx-client-ui-settings-general": "workspace:^",
    "@arx-ai/arx-client-runtime": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/browser.js",
    "lib/types/**/*.d.ts"
  ]
}
