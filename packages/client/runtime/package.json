{
  "name": "@centurionarx/cxh-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cxh": {
    "client": {
      "inject": [
        "@centurionarx/cxh-client-connection",
        "@centurionarx/cxh-typert-registry",
        "@centurionarx/cxh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@centurionarx/cordis": "workspace:^",
    "@centurionarx/cxh-api-remotes": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-typert-protocol": "workspace:^",
    "@centurionarx/cxh-typert-registry": "workspace:^",
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-attachment": "workspace:^",
    "@centurionarx/cxh-client-connection": "workspace:^",
    "@centurionarx/cxh-commands": "workspace:^",
    "@centurionarx/cxh-host-apiproxy": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-llm-retry": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-session-projection": "workspace:^",
    "@centurionarx/cxh-session-title": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cordis": "workspace:^",
    "@centurionarx/cxh-api-remotes": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-timeout": "workspace:^",
    "@centurionarx/cxh-typert-protocol": "workspace:^",
    "@centurionarx/cxh-typert-registry": "workspace:^",
    "@types/react": "~18.3.1",
    "@centurionarx/cxh-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-attachment": "workspace:^",
    "@centurionarx/cxh-client-connection": "workspace:^",
    "@centurionarx/cxh-commands": "workspace:^",
    "@centurionarx/cxh-host-apiproxy": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-llm-retry": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-session-projection": "workspace:^",
    "@centurionarx/cxh-session-title": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
