{
  "name": "@arx-ai/arx-isolated-project-runtime",
  "description": "Fail-closed owner-scoped HTTP worker dispatch and quiescence",
  "version": "1.0.65",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker-persistence.d.ts",
      "default": "./lib/types/worker-persistence.js"
    },
    "./broker-http": {
      "types": "./lib/types/broker-http.d.ts",
      "default": "./lib/types/broker-http.js"
    },
    "./worker-boundary": {
      "types": "./lib/types/worker-boundary.d.ts",
      "default": "./lib/types/worker-boundary.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@arx-ai/arx-web-identity": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-workspace": "workspace:^",
    "@arx-ai/schemastery": "workspace:^",
    "@arx-ai/arx-host-apiproxy": "workspace:^",
    "@arx-ai/arx-project-storage": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^",
    "@arx-ai/arx-host-webserver": "workspace:^",
    "zod": "^4.4.3",
    "@arx-ai/arx-session-query": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "fflate": "^0.8.2",
    "@arx-ai/arx-subagent": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/host/isolated-project-runtime"
  }
}
