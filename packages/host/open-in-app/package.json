{
  "name": "@arx-ai/arx-host-open-in-app",
  "description": "Host half of open-in-app: resolves installed editors, Git GUIs, terminals, and file managers to verified launchers and serves the catalog, icons, and launches over a loopback-only connection RPC channel",
  "version": "1.0.28",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/host/open-in-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./shared": {
      "types": "./lib/types/shared.d.ts",
      "default": "./lib/types/shared.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@arx-ai/arx-launch-environment": "workspace:^",
    "@arx-ai/arx-native-command": "workspace:^",
    "@arx-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/arx-client-connection": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-client-connection": "workspace:^",
    "@arx-ai/arx-host-webserver": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/cordis-plugin-include": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^"
  }
}
