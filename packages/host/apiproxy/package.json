{
  "name": "@centurionarx/cxh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@centurionarx/cxh-attachment": "workspace:^",
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-agent-default-model": "workspace:^",
    "@centurionarx/cxh-api-remotes": "workspace:^",
    "@centurionarx/cxh-brand": "workspace:^",
    "@centurionarx/cxh-commands": "workspace:^",
    "@centurionarx/cxh-credentials": "workspace:^",
    "@centurionarx/cxh-goal": "workspace:^",
    "@centurionarx/cxh-host-directory-picker": "workspace:^",
    "@centurionarx/cxh-llm": "workspace:^",
    "@centurionarx/cxh-native-command": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-session-persistence": "workspace:^",
    "@centurionarx/cxh-session-projection": "workspace:^",
    "@centurionarx/cxh-session-projection-cache": "workspace:^",
    "@centurionarx/cxh-session-query": "workspace:^",
    "@centurionarx/cxh-session-title": "workspace:^",
    "@centurionarx/cxh-settings": "workspace:^",
    "@centurionarx/cxh-skill": "workspace:^",
    "@centurionarx/cxh-subagent": "workspace:^",
    "@centurionarx/cxh-jobs": "workspace:^",
    "@centurionarx/cxh-tools": "workspace:^",
    "@centurionarx/cxh-user-approval": "workspace:^",
    "@centurionarx/cxh-user-questions": "workspace:^",
    "@centurionarx/cxh-workspace": "workspace:^",
    "@centurionarx/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@centurionarx/cordis": "workspace:^",
    "@centurionarx/cxh-agent-presets": "workspace:^",
    "@centurionarx/cxh-cordis-host-runner": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cordis": "workspace:^",
    "@centurionarx/cxh-agent-presets": "workspace:^",
    "@centurionarx/cxh-cordis-host-runner": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-storage": "workspace:^",
    "@centurionarx/cxh-storage-domain": "workspace:^",
    "@centurionarx/cxh-typert-protocol": "workspace:^",
    "@centurionarx/cxh-typert-registry": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  }
}
