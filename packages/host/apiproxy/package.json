{
  "name": "@arx-ai/arx-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "1.0.15",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-default-model": "workspace:^",
    "@arx-ai/arx-api-remotes": "workspace:^",
    "@arx-ai/arx-attachment": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-cmdline": "workspace:*",
    "@arx-ai/arx-commands": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-goal": "workspace:^",
    "@arx-ai/arx-host-directory-picker": "workspace:^",
    "@arx-ai/arx-jobs": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-native-command": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^",
    "@arx-ai/arx-session-projection": "workspace:^",
    "@arx-ai/arx-session-projection-cache": "workspace:^",
    "@arx-ai/arx-session-query": "workspace:^",
    "@arx-ai/arx-session-title": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-skill": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/arx-user-approval": "workspace:^",
    "@arx-ai/arx-user-questions": "workspace:^",
    "@arx-ai/arx-workspace": "workspace:^",
    "@arx-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3",
    "@arx-ai/arx-web": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-agent-presets": "workspace:^",
    "@arx-ai/arx-cordis-host-runner": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-agent-presets": "workspace:^",
    "@arx-ai/arx-cordis-host-runner": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-storage": "workspace:^",
    "@arx-ai/arx-storage-domain": "workspace:^",
    "@arx-ai/arx-typert-protocol": "workspace:^",
    "@arx-ai/arx-typert-registry": "workspace:^"
  }
}
