{
  "name": "@centurionarx/cxh-terminal-bash",
  "description": "Persistent shell PTY backend over the CENTURIONarx Harness subprocess terminal primitive",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/centurionarx-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-terminal": "workspace:^",
    "@centurionarx/cxh-sandbox": "workspace:^",
    "@centurionarx/cxh-sandbox-policy": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-subprocess": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  },
  "dependencies": {
    "@centurionarx/cxh-pwsh-local": "workspace:^",
    "@centurionarx/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@centurionarx/cxh-agent": "workspace:^",
    "@centurionarx/cxh-invariants": "workspace:^",
    "@centurionarx/cxh-terminal": "workspace:^",
    "@centurionarx/cxh-sandbox": "workspace:^",
    "@centurionarx/cxh-sandbox-policy": "workspace:^",
    "@centurionarx/cxh-session": "workspace:^",
    "@centurionarx/cxh-subprocess": "workspace:^",
    "@centurionarx/cxh-subprocess-local": "workspace:^",
    "@centurionarx/cordis": "workspace:^"
  }
}
