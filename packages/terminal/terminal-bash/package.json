{
  "name": "@arx-ai/arx-terminal-bash",
  "description": "Persistent shell PTY backend over the arx Harness subprocess terminal primitive",
  "version": "1.0.42",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-terminal": "workspace:^",
    "@arx-ai/arx-sandbox": "workspace:^",
    "@arx-ai/arx-sandbox-policy": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@arx-ai/arx-pwsh-local": "workspace:^",
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-terminal": "workspace:^",
    "@arx-ai/arx-sandbox": "workspace:^",
    "@arx-ai/arx-sandbox-policy": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-subprocess-local": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
