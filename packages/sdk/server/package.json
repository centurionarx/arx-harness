{
  "name": "@arx-ai/arx-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process arx Harness SDK clients",
  "version": "1.0.45",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-scope": "workspace:^",
    "@arx-ai/arx-sdk-protocol": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-spine-demo": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-llm-pi-ai": "workspace:^",
    "@arx-ai/arx-scope": "workspace:^",
    "@arx-ai/arx-sdk-protocol": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence-jsonl": "workspace:^",
    "@arx-ai/arx-subagent": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^"
  }
}
