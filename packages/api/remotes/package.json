{
  "name": "@arx-ai/arx-api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "1.0.46",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "arx": {
    "client": {
      "inject": [
        "@arx-ai/arx-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@arx-ai/arx-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-presets": "workspace:^",
    "@arx-ai/arx-api-gateway": "workspace:^",
    "@arx-ai/arx-commands": "workspace:^",
    "@arx-ai/arx-cordis-host-runner": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-file-reference": "workspace:^",
    "@arx-ai/arx-goal": "workspace:^",
    "@arx-ai/arx-host-plugin-inventory": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-message-feedback": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^",
    "@arx-ai/arx-session-reference": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-typert-registry": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-web": "workspace:^",
    "@arx-ai/arx-project": "workspace:^",
    "@arx-ai/arx-file-preview": "workspace:^",
    "@arx-ai/arx-repository": "workspace:^",
    "@arx-ai/arx-github": "workspace:^",
    "@arx-ai/arx-session-turn-outline": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-presets": "workspace:^",
    "@arx-ai/arx-api-gateway": "workspace:^",
    "@arx-ai/arx-commands": "workspace:^",
    "@arx-ai/arx-cordis-host-runner": "workspace:^",
    "@arx-ai/arx-credentials": "workspace:^",
    "@arx-ai/arx-file-reference": "workspace:^",
    "@arx-ai/arx-goal": "workspace:^",
    "@arx-ai/arx-host-plugin-inventory": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-message-feedback": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^",
    "@arx-ai/arx-session-reference": "workspace:^",
    "@arx-ai/arx-settings": "workspace:^",
    "@arx-ai/arx-typert-registry": "workspace:^",
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-web": "workspace:^",
