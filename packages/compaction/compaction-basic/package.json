{
  "name": "@arx-ai/arx-compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the arx Harness",
  "version": "1.0.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-compaction": "workspace:^",
    "@arx-ai/arx-commands": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-token-meter": "workspace:^",
    "@arx-ai/arx-compaction-tool-result-pruner": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@arx-ai/arx-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis-plugin-include": "workspace:^",
    "@arx-ai/cordis-plugin-loader": "workspace:^",
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-loop": "workspace:^",
    "@arx-ai/arx-agent-loop-testkit": "workspace:^",
    "@arx-ai/arx-compaction": "workspace:^",
    "@arx-ai/arx-commands": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-llm-retry": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-token-meter": "workspace:^",
    "@arx-ai/arx-compaction-tool-result-pruner": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
