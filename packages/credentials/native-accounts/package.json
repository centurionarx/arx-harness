{
  "name": "@arx-ai/arx-native-accounts",
  "version": "1.0.10",
  "description": "Native Claude Code and Codex account status and bounded sign-in",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/invariant.js"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex": "0.147.0",
    "@arx-ai/arx-sdk-protocol": "workspace:^",
    "@arx-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-claude-agent-sdk-process": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/cordis": "workspace:^",
    "@arx-ai/arx-brand": "workspace:^",
    "@arx-ai/arx-subprocess": "workspace:^",
    "@arx-ai/arx-claude-agent-sdk-process": "workspace:^",
    "@arx-ai/arx-app-boot": "workspace:^",
    "@arx-ai/arx-loader-smoke": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-subprocess-local": "workspace:^"
  }
}
