{
  "name": "@arx-ai/arx-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the arx Harness interception seams",
  "version": "1.0.46",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centurionarx/arx-harness.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@arx-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-hook-protocol": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@arx-ai/arx-agent": "workspace:^",
    "@arx-ai/arx-agent-loop": "workspace:^",
    "@arx-ai/arx-agent-loop-testkit": "workspace:^",
    "@arx-ai/arx-shell": "workspace:^",
    "@arx-ai/arx-bash-local": "workspace:^",
    "@arx-ai/arx-subprocess-local": "workspace:^",
    "@arx-ai/arx-hook-protocol": "workspace:^",
    "@arx-ai/arx-invariants": "workspace:^",
    "@arx-ai/arx-llm": "workspace:^",
    "@arx-ai/arx-session": "workspace:^",
    "@arx-ai/arx-session-persistence": "workspace:^",
    "@arx-ai/arx-session-persistence-jsonl": "workspace:^",
    "@arx-ai/arx-tools": "workspace:^",
    "@arx-ai/cordis": "workspace:^"
  }
}
